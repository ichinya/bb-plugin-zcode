{
  "name": "bb-plugin-zcode",
  "version": "0.1.0",
  "description": "ZCode CLI/ACP bridge with Coding Plan, Start Plan and provider sources, plus quota reporting for BB.",
  "keywords": [
    "bb-plugin",
    "provider",
    "zcode",
    "acp",
    "glm",
    "z.ai"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "scripts": {
    "build:cli": "node scripts/build-native-auth.mjs --check",
    "test:cli": "node --test tests/remote-link.test.mjs tests/native-wire.test.mjs",
    "doctor:cli": "node bin/zcode-cli-acp.mjs --doctor",
    "register:cli": "node scripts/register-cli-agent.mjs --register",
    "test:usage": "node --test tests/usage-cache.test.mjs tests/usage-source.test.mjs",
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test tests/native-wire.test.mjs tests/remote-link.test.mjs tests/usage-cache.test.mjs tests/usage-source.test.mjs tests/auto-tag.test.mjs tests/ci-module.test.mjs",
    "verify": "npm run typecheck && npm run build:cli && npm run build && npm run test:ci"
  },
  "bb": {
    "name": "Провайдер ZCode",
    "description": "ZCode CLI/ACP and separate Coding Plan / Start Plan quotas in BB. Includes the original macOS GUI bridge.",
    "branding": {
      "icon": "./icons/zcode.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.49.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zcode-acp": "git+https://github.com/ichinya/zcode-acp.git#cf838ada4436221a0a17761e12a07de13f843b75",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichinya/bb-plugin-zcode.git"
  },
  "homepage": "https://ichinya.github.io/bb-plugin-zcode/",
  "bugs": {
    "url": "https://github.com/ichinya/bb-plugin-zcode/issues"
  },
  "author": "Kirill Vechkasov"
}
